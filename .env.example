# FrontendForge Environment Configuration Example

# Set to 'false' to route requests to backend API instead of local mock data
VITE_USE_MOCK_DATA=true

# Remote backend API base URL (e.g. http://localhost:5000)
VITE_API_BASE_URL=

# Production Cloudflare AI Proxy (defaults to https://feeq-ai-proxy.pages.dev)
VITE_AI_PROXY_URL=https://feeq-ai-proxy.pages.dev
